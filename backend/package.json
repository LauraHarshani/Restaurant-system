{
  "name": "backend",
  "version": "1.0.0",
  "description": "Flame & Crust Restaurant Backend API",
  "main": "server.js",
  "scripts": {
    "start": "tsx server.js",
    "dev": "nodemon --exec tsx server.js",
    "generate": "npm run db:sqlite:generate",
    "db:sqlite:generate": "prisma generate --config prisma.sqlite.config.ts",
    "db:sqlite:migrate": "prisma migrate deploy --config prisma.sqlite.config.ts",
    "db:sqlite:migrate:dev": "prisma migrate dev --config prisma.sqlite.config.ts",
    "db:sqlite:status": "prisma migrate status --config prisma.sqlite.config.ts",
    "db:sqlite:studio": "prisma studio --config prisma.sqlite.config.ts",
    "db:mysql:generate": "prisma generate --config prisma.mysql.config.ts",
    "db:mysql:migrate": "prisma migrate deploy --config prisma.mysql.config.ts",
    "db:mysql:migrate:dev": "prisma migrate dev --config prisma.mysql.config.ts",
    "db:mysql:status": "prisma migrate status --config prisma.mysql.config.ts",
    "db:mysql:studio": "prisma studio --config prisma.mysql.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  }
}
